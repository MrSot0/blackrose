---
import Icon from './Icon.astro';
import { services, site, waLink } from '../data/site';
const words = services.map((s) => s.title.toLowerCase());
---
<section id="contact" class="relative isolate overflow-hidden bg-carbon-950 py-24 md:py-36">
  <!-- moving colour field -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="animate-blob absolute -top-1/4 left-1/4 size-[46rem] rounded-full bg-gold-400/25 blur-[130px]"></div>
    <div class="animate-blob absolute -bottom-1/3 -left-1/4 size-[40rem] rounded-full bg-rose-500/30 blur-[130px] [animation-delay:-6s]"></div>
    <div class="animate-blob absolute top-1/3 -right-1/4 size-[36rem] rounded-full bg-rose-700/40 blur-[130px] [animation-delay:-12s]"></div>
  </div>

  <div class="container-x relative grid gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <p class="reveal text-xs font-medium tracking-[0.3em] text-gold-300 uppercase">Contact</p>
      <h2 class="display reveal mt-5 text-[clamp(2.3rem,6vw,4.6rem)] leading-[1.04]" style="--d:80ms">
        Let’s talk<br />
        <span class="relative inline-block h-[1.1em] overflow-hidden align-bottom" aria-hidden="true">
          <span id="rotator" class="text-gold-gradient block" data-words={JSON.stringify(words)}>{words[0]}</span>
        </span>
        <span class="sr-only">about your project</span>
      </h2>
      <p class="reveal mt-8 max-w-md text-lg leading-relaxed text-bone-100" style="--d:160ms">
        Fill in the form and WhatsApp opens with your message ready to send. Photos of the space or vehicle help us quote faster.
      </p>

      <div class="reveal mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2" style="--d:240ms">
        <a href={waLink()} target="_blank" rel="noopener" class="group flex items-center gap-4 rounded-2xl border border-bone-50/10 bg-bone-50/5 p-4 backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:border-[#25D366]/60 hover:bg-[#25D366]/10">
          <span class="grid size-12 shrink-0 place-items-center rounded-full bg-[#25D366] text-carbon-950 transition-transform duration-300 group-hover:rotate-[-10deg] group-hover:scale-110"><Icon name="whatsapp" class="size-6" /></span>
          <span>
            <span class="field-label !mb-0">WhatsApp</span>
            <span class="block text-bone-50">{site.phoneDisplay}</span>
          </span>
        </a>
        <a href={`mailto:${site.email}`} class="group flex items-center gap-4 rounded-2xl border border-bone-50/10 bg-bone-50/5 p-4 backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:border-gold-400/60 hover:bg-gold-400/10">
          <span class="grid size-12 shrink-0 place-items-center rounded-full bg-gold-gradient text-carbon-950 transition-transform duration-300 group-hover:rotate-[-10deg] group-hover:scale-110">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
          </span>
          <span class="min-w-0">
            <span class="field-label !mb-0">Email</span>
            <span class="block truncate text-bone-50">{site.email}</span>
          </span>
        </a>
      </div>

      <div class="reveal mt-8 flex items-center gap-3" style="--d:300ms">
        <span class="field-label !mb-0 mr-2">Follow</span>
        {site.socials.map((s) => (
          <a href={s.href} {...(s.href !== '#' && { target: '_blank', rel: 'noopener' })} aria-label={s.name} class="grid size-11 place-items-center rounded-full border border-bone-50/15 text-bone-100 transition-all duration-300 hover:-translate-y-1 hover:border-gold-400 hover:bg-gold-400 hover:text-carbon-950">
            <Icon name={s.icon} />
          </a>
        ))}
      </div>
    </div>

    <form id="contact-form" class="reveal relative self-start rounded-3xl bg-bone-50 p-6 text-carbon-950 shadow-[0_40px_80px_-30px_rgb(0_0_0/0.7)] sm:p-8 md:p-10 lg:col-span-7 lg:col-start-6 xl:col-span-6 xl:col-start-7" style="--d:200ms" novalidate>
      <div class="absolute -top-px right-10 left-10 h-1 rounded-b-full bg-gradient-to-r from-gold-400 via-rose-500 to-gold-400" aria-hidden="true"></div>
      <p class="font-display text-2xl font-light">Request a quote</p>
      <p class="mt-1 text-sm text-steel-600">Fields marked * are required.</p>

      <fieldset class="mt-8">
        <legend class="mb-3 text-xs font-semibold tracking-[0.2em] text-steel-600 uppercase">What do you need? *</legend>
        <div class="flex flex-wrap gap-2" id="cf-service">
          {[...services.map((s) => s.title), 'Something else'].map((t) => (
            <label class="chip cursor-pointer">
              <input type="radio" name="service" value={t} class="peer sr-only" required />
              <span class="inline-block rounded-full border border-carbon-950/15 px-4 py-2 text-sm transition-all duration-300 peer-checked:scale-105 peer-checked:border-transparent peer-checked:bg-carbon-950 peer-checked:text-gold-300 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-gold-500 hover:border-carbon-950/50">{t}</span>
            </label>
          ))}
        </div>
        <p class="error mt-2 hidden text-sm text-rose-500" id="cf-service-err">Pick the closest match.</p>
      </fieldset>

      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <div class="float">
          <input id="cf-name" name="name" type="text" autocomplete="name" required placeholder=" " aria-describedby="cf-name-err" />
          <label for="cf-name">Name *</label>
          <p class="error mt-2 hidden text-sm text-rose-500" id="cf-name-err">Please tell us your name.</p>
        </div>
        <div class="float">
          <input id="cf-company" name="company" type="text" autocomplete="organization" placeholder=" " />
          <label for="cf-company">Company</label>
        </div>
        <div class="float sm:col-span-2">
          <input id="cf-email" name="email" type="email" autocomplete="email" placeholder=" " aria-describedby="cf-email-err" />
          <label for="cf-email">Email</label>
          <p class="error mt-2 hidden text-sm text-rose-500" id="cf-email-err">That email doesn’t look right.</p>
        </div>
        <div class="float sm:col-span-2">
          <textarea id="cf-message" name="message" rows="4" required placeholder=" " aria-describedby="cf-message-err"></textarea>
          <label for="cf-message">What are we branding, where, and by when? *</label>
          <p class="error mt-2 hidden text-sm text-rose-500" id="cf-message-err">A few words about the project, please.</p>
        </div>
      </div>

      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-xs text-steel-600">Nothing is sent until you press send in WhatsApp.</p>
        <button type="submit" class="send-btn group relative inline-flex items-center justify-center gap-3 overflow-hidden rounded-full bg-carbon-950 px-7 py-4 text-sm font-medium text-bone-50">
          <span class="absolute inset-0 -translate-x-full bg-[#25D366] transition-transform duration-500 ease-out-soft group-hover:translate-x-0" aria-hidden="true"></span>
          <span class="relative flex items-center gap-3 transition-colors duration-300 group-hover:text-carbon-950">
            <Icon name="whatsapp" class="size-5" /> Send via WhatsApp <Icon name="arrow" class="arrow size-4" />
          </span>
        </button>
      </div>
      <p id="cf-status" class="mt-4 rounded-xl bg-[#25D366]/15 px-4 py-3 text-sm text-carbon-950 empty:hidden" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style is:global>
  .float { position: relative; }
  .float input,
  .float textarea {
    width: 100%;
    border: 0;
    border-bottom: 1.5px solid rgb(11 11 12 / 0.15);
    background: transparent;
    padding: 1.4rem 0 0.55rem;
    color: #0b0b0c;
    resize: none;
    transition: border-color 0.3s;
  }
  .float input:focus,
  .float textarea:focus { outline: none; border-color: #c29a4b; }
  .float label {
    position: absolute;
    left: 0;
    top: 1.35rem;
    color: #3b3b44;
    pointer-events: none;
    transform-origin: left top;
    transition: transform 0.3s var(--ease-out-soft), color 0.3s;
  }
  .float input:focus + label,
  .float input:not(:placeholder-shown) + label,
  .float textarea:focus + label,
  .float textarea:not(:placeholder-shown) + label {
    transform: translateY(-1.3rem) scale(0.78);
    color: #7a5f2c;
    letter-spacing: 0.04em;
  }
  .float [aria-invalid='true'] { border-color: #c8364f; }
  #rotator.swap { animation: word-in 0.6s var(--ease-out-soft); }
</style>
