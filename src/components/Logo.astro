---
// Official Blackrose logo, vectorised from the client's artwork (public/logo.svg).
// Rendered as a CSS mask so it can take any colour or gradient.
interface Props { class?: string; size?: 'sm' | 'lg'; tone?: 'light' | 'gold' }
const { class: cls = '', size = 'sm', tone = 'light' } = Astro.props;
---
<span
  role="img"
  aria-label="Blackrose"
  class:list={[
    'logo-mark inline-block aspect-[1817/1231]',
    size === 'lg' ? 'h-28 md:h-32' : 'h-13 md:h-16',
    tone === 'gold' ? 'bg-gold-gradient' : 'bg-bone-50',
    cls,
  ]}
></span>

<style is:global>
  .logo-mark {
    -webkit-mask: url('/logo.svg') center / contain no-repeat;
    mask: url('/logo.svg') center / contain no-repeat;
  }
</style>
