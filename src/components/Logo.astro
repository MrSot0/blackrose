---
// Typographic recreation of the Blackrose logo (serif "BLACK", script "Rose", line-drawn rose).
// TODO: swap for the official SVG/PNG logo file when supplied.
interface Props { class?: string; size?: 'sm' | 'lg' }
const { class: cls = '', size = 'sm' } = Astro.props;
const lg = size === 'lg';
---
<span class:list={['relative inline-flex flex-col items-center leading-none text-bone-50 select-none', cls]} aria-label="Blackrose" role="img">
  <svg class:list={['text-gold-400', lg ? 'mb-[-0.4rem] h-14 w-10' : 'mb-[-0.25rem] h-6 w-5']} viewBox="0 0 24 34" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3c3.6 0 6.4 2.4 6.4 5.6 0 3.4-2.9 5.8-6.4 5.8s-6.4-2.4-6.4-5.8C5.6 5.4 8.4 3 12 3Z"/>
    <path d="M12 5.5c1.9 0 3.4 1.3 3.4 3 0 1.8-1.5 3.1-3.4 3.1S8.6 10.3 8.6 8.5c0-1.7 1.5-3 3.4-3Z"/>
    <path d="M9.6 7.4c1.4.2 2.4 1 2.4 2.3M14.4 7.4c-1.4.2-2.4 1-2.4 2.3"/>
    <path d="M12 14.4V33M12 21c-2.5-.4-4.6-1.8-5.4-4 2.6-.2 4.6.9 5.4 3M12 25c2.5-.4 4.6-1.8 5.4-4-2.6-.2-4.6.9-5.4 3"/>
  </svg>
  <span class:list={['font-serif font-light tracking-[0.14em]', lg ? 'text-6xl' : 'text-[1.65rem]']}>BLACK</span>
  <span class:list={['font-script text-gold-400', lg ? '-mt-5 text-6xl' : '-mt-[0.7rem] text-[1.75rem]']} aria-hidden="true">Rose</span>
</span>
