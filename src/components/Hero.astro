---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import heroImg from '../assets/work/424690.jpg';
import sideImg from '../assets/work/424687.jpg';
import { services } from '../data/site';
const lines = ['Branding', 'you can', 'walk into.'];
---
<section id="top" class="relative overflow-hidden pt-32 pb-16 md:pt-40 md:pb-24">
  <!-- soft gold glow -->
  <div class="pointer-events-none absolute -top-40 right-[-10%] size-[42rem] rounded-full bg-gold-400/10 blur-[120px]" aria-hidden="true"></div>

  <div class="container-x relative grid gap-12 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <p class="eyebrow hero-fade !tracking-[0.2em] sm:!tracking-[0.3em]" style="--d:200ms">Events · Car Wraps · Vinyl · Wallpaper</p>
      <h1 class="display mt-6 text-[clamp(2.9rem,9vw,7.25rem)] leading-[1.02]">
        {lines.map((l, i) => (
          <span class="line-mask"><span style={`--d:${300 + i * 120}ms`} class={i === 2 ? 'text-gold-400' : ''}>{l}</span></span>
        ))}
      </h1>
      <p class="hero-fade mt-8 max-w-lg text-lg leading-relaxed text-ash-200" style="--d:750ms">
        We design, print and install event sets, car wraps, decals and wallpaper for homes and businesses.
      </p>
      <div class="hero-fade mt-10 flex flex-wrap gap-4" style="--d:900ms">
        <a href="#contact" class="btn-gold">Get a quote <Icon name="arrow" class="arrow size-4" /></a>
        <a href="#work" class="btn-ghost">View our work</a>
      </div>
    </div>

    <div class="relative lg:col-span-5">
      <div class="hero-fade relative aspect-[16/10] w-full overflow-hidden lg:ml-auto lg:aspect-[4/5] lg:max-w-md" style="--d:500ms">
        <Image src={heroImg} alt="Red-lit event stage with an LED wall reflecting on a glossy floor" widths={[400, 700, 1000]} sizes="(min-width: 1024px) 28rem, 100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-carbon-950/60 to-transparent"></div>
      </div>
      <div class="hero-fade absolute -bottom-8 -left-16 hidden aspect-[3/4] w-48 overflow-hidden border-4 border-carbon-950 lg:block" style="--d:800ms">
        <Image src={sideImg} alt="Wrapped retail display plinth" widths={[200, 400]} sizes="12rem" loading="eager" class="h-full w-full object-cover" />
      </div>
      <div class="hero-fade absolute top-6 -right-1 hidden border-l border-gold-400 bg-carbon-950/80 py-2 pr-4 pl-3 text-xs tracking-[0.2em] text-bone-50 uppercase backdrop-blur sm:block md:right-4" style="--d:1000ms">
        Design → Print → Install
      </div>
    </div>
  </div>

  <!-- marquee -->
  <div class="hero-fade mt-24 border-y border-carbon-700 py-5 md:mt-32" style="--d:1100ms" aria-hidden="true">
    <div class="flex overflow-hidden">
      <div class="animate-marquee flex shrink-0 gap-12 pr-12 whitespace-nowrap">
        {[...services, ...services].map((s) => (
          <span class="flex items-center gap-12 font-display text-xl font-extralight text-ash-400 md:text-2xl">
            {s.title}<span class="size-1.5 rotate-45 bg-gold-400"></span>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
