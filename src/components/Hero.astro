---
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { services } from '../data/site';

// Every portfolio photo, resized once to a small WebP and reused across the moving columns.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.webp', { eager: true });
const photos = await Promise.all(
  Object.values(files).map((m) => getImage({ src: m.default, widths: [240, 360], format: 'webp', quality: 58 })),
);
const COLS = 6;
// Distribute photos so neighbouring columns start on different images
const columns = Array.from({ length: COLS }, (_, c) =>
  Array.from({ length: 6 }, (_, k) => photos[(c * 3 + k * 5) % photos.length]),
);
const heights = ['aspect-[3/4]', 'aspect-[4/5]', 'aspect-square', 'aspect-[4/3]'];
const lines = ['Branding you can', 'walk into.'];
---
<section id="top" class="relative isolate flex min-h-[100svh] flex-col overflow-hidden">
  <!-- Collage background -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="collage absolute -inset-x-[10%] -inset-y-[20%] grid -rotate-6 grid-cols-3 gap-3 md:grid-cols-6 md:gap-4">
      {columns.map((col, c) => (
        <div class:list={['collage-col overflow-hidden', c >= 3 && 'hidden md:block']}>
          <div class:list={['collage-track flex flex-col gap-3 pb-3 md:gap-4 md:pb-4', c % 2 ? 'is-down' : 'is-up']} style={`--dur:${46 + (c % 3) * 12}s`}>
            {[...col, ...col].map((img, k) => (
              <img
                src={img.src}
                srcset={img.srcSet.attribute}
                sizes="(min-width: 768px) 17vw, 38vw"
                alt=""
                width="360"
                height="450"
                loading={c < 3 && k % 6 < 3 ? 'eager' : 'lazy'}
                fetchpriority={c < 3 && k % 6 < 2 ? 'high' : 'auto'}
                decoding="async"
                class:list={['w-full rounded-xl object-cover', heights[(c + k) % heights.length]]}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
    <!-- colour + legibility layers -->
    <div class="absolute inset-0 bg-carbon-950/40"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgb(11_11_12/0.88)_0%,rgb(11_11_12/0.6)_45%,rgb(11_11_12/0.35)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-carbon-950/80 to-transparent"></div>
    <div class="animate-blob absolute -top-1/4 -right-1/4 size-[70vmax] rounded-full bg-rose-500/25 mix-blend-screen blur-[120px]"></div>
    <div class="animate-blob absolute -bottom-1/3 -left-1/4 size-[60vmax] rounded-full bg-gold-400/20 mix-blend-screen blur-[120px] [animation-delay:-9s]"></div>
  </div>

  <div class="container-x relative flex flex-1 flex-col items-center justify-center pt-24 pb-14 text-center md:pt-28 md:pb-20">
    <h1 class="display text-[clamp(2.2rem,6.2vw,5rem)] leading-[1.04]">
      {lines.map((l, i) => (
        <span class="line-mask"><span style={`--d:${300 + i * 120}ms`} class={i === 1 ? 'text-gold-gradient' : ''}>{l}</span></span>
      ))}
    </h1>
    <p class="hero-fade mt-5 max-w-sm text-base text-bone-100 md:mt-6 md:text-lg" style="--d:650ms">
      Event branding, car wraps, decals and wallpaper.
    </p>
    <div class="hero-fade mt-8 flex flex-wrap justify-center gap-3 sm:gap-4" style="--d:800ms">
      <a href="#contact" class="btn-gold">Get a quote <Icon name="arrow" class="arrow size-4" /></a>
      <a href="#work" class="btn-ghost backdrop-blur-sm">See our work</a>
    </div>

    <a href="#services" class="hero-fade absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 text-xs tracking-[0.3em] text-bone-100 uppercase md:flex" style="--d:1200ms">
      Scroll
      <span class="relative block h-12 w-px overflow-hidden bg-bone-50/20">
        <span class="absolute inset-x-0 top-0 h-1/2 animate-[scrollcue_1.8s_ease-in-out_infinite] bg-gold-400"></span>
      </span>
    </a>
  </div>

  <!-- gold marquee -->
  <div class="hero-fade bg-gold-gradient relative py-4 text-carbon-950" style="--d:1100ms" aria-hidden="true">
    <div class="flex overflow-hidden">
      <div class="animate-marquee flex shrink-0 gap-10 pr-10 whitespace-nowrap">
        {[...services, ...services, ...services].map((s) => (
          <span class="flex items-center gap-10 font-display text-lg font-light md:text-xl">
            {s.title}<span class="size-1.5 rotate-45 bg-rose-700"></span>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  @keyframes collage-up { from { transform: translateY(0); } to { transform: translateY(-50%); } }
  @keyframes collage-down { from { transform: translateY(-50%); } to { transform: translateY(0); } }
  .collage-track { animation: collage-up var(--dur, 50s) linear infinite; will-change: transform; }
  .collage-track.is-down { animation-name: collage-down; }
  @media (prefers-reduced-motion: reduce) { .collage-track { animation: none; } }
  @keyframes scrollcue {
    from { transform: translateY(-100%); }
    to { transform: translateY(200%); }
  }
</style>
