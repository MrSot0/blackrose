---
import { process } from '../data/site';
---
<section id="process" class="py-24 md:py-36">
  <div class="container-x">
    <p class="eyebrow reveal">Process</p>
    <h2 class="display reveal mt-5 max-w-3xl text-[clamp(2rem,5vw,3.75rem)] leading-[1.08]" style="--d:80ms">From first message to final install.</h2>
    <ol class="mt-16 grid gap-px bg-carbon-700 sm:grid-cols-2 lg:grid-cols-4 md:mt-24">
      {process.map((s, i) => (
        <li class="reveal bg-carbon-950 p-8 md:p-10" style={`--d:${i * 90}ms`}>
          <span class="font-display text-5xl font-extralight text-gold-400/80">0{i + 1}</span>
          <h3 class="mt-8 font-display text-xl font-light text-bone-50">{s.title}</h3>
          <p class="mt-3 leading-relaxed text-ash-400">{s.copy}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
