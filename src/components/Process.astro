---
import { process } from '../data/site';
const icons = [
  // brief: chat bubble
  '<path d="M4 5h16v11H8l-4 4V5Z"/><path d="M8 9h8M8 12h5"/>',
  // design: pen nib
  '<path d="m12 3 7 7-7 11-7-11 7-7Z"/><circle cx="12" cy="11" r="2"/><path d="M12 13v8"/>',
  // produce: layers
  '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/>',
  // install: pin
  '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>',
];
---
<section id="process" class="relative overflow-hidden bg-gradient-to-b from-steel-900 via-steel-800 to-steel-900 py-24 md:py-36" data-process>
  <div class="pointer-events-none absolute inset-0 opacity-[0.07] [background-image:radial-gradient(circle_at_1px_1px,#f4f2ee_1px,transparent_0)] [background-size:28px_28px]" aria-hidden="true"></div>

  <div class="container-x relative">
    <p class="reveal text-xs font-medium tracking-[0.3em] text-gold-400 uppercase">Process</p>
    <h2 class="display reveal mt-5 max-w-3xl text-[clamp(2rem,5vw,3.75rem)] leading-[1.08]" style="--d:80ms">
      From first message<br />to <span class="text-gold-gradient">final install.</span>
    </h2>

    <div class="relative mt-16 md:mt-24">
      <!-- connector line (horizontal on desktop, vertical on mobile) -->
      <div class="absolute top-0 bottom-0 left-[1.4rem] w-px bg-steel-600 lg:top-[1.4rem] lg:right-[12.5%] lg:bottom-auto lg:left-[12.5%] lg:h-px lg:w-auto" aria-hidden="true">
        <div class="process-fill absolute inset-0 origin-top bg-gradient-to-b from-gold-300 via-gold-400 to-rose-500 lg:origin-left lg:bg-gradient-to-r"></div>
      </div>

      <ol class="relative grid gap-10 lg:grid-cols-4 lg:gap-6">
        {process.map((s, i) => (
          <li class="process-step relative grid grid-cols-[2.8rem_1fr] gap-5 lg:grid-cols-1 lg:justify-items-center lg:gap-8" data-step={i}>
            <span class="node relative z-10 grid size-11 place-items-center rounded-full border border-steel-600 bg-steel-900 font-display text-sm text-ash-400 transition-all duration-500">
              0{i + 1}
            </span>
            <div class="flip h-56 w-full [perspective:1200px] sm:h-52 lg:h-64">
              <div class="flip-inner relative h-full w-full transition-transform duration-[900ms] ease-out-soft [transform-style:preserve-3d]">
                <!-- front: inactive -->
                <div class="absolute inset-0 flex flex-col items-start justify-between rounded-2xl border border-steel-600 bg-steel-800/80 p-6 [backface-visibility:hidden]" aria-hidden="true">
                  <svg class="size-9 text-ash-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} />
                  <span class="font-display text-6xl font-extralight text-steel-600">0{i + 1}</span>
                </div>
                <!-- back: active -->
                <div class="absolute inset-0 flex flex-col justify-between overflow-hidden rounded-2xl bg-gold-gradient p-6 text-carbon-950 [backface-visibility:hidden] [transform:rotateY(180deg)]">
                  <div class="flex items-center justify-between">
                    <svg class="size-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
                    <span class="font-display text-sm">Step 0{i + 1}</span>
                  </div>
                  <div>
                    <h3 class="font-display text-2xl font-light">{s.title}</h3>
                    <p class="mt-2 leading-relaxed text-carbon-900/80">{s.copy}</p>
                  </div>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style is:global>
  .process-fill { transform: scaleY(var(--p, 0)); }
  @media (min-width: 1024px) { .process-fill { transform: scaleX(var(--p, 0)); } }
  .process-step.is-active .node {
    border-color: transparent;
    background: linear-gradient(120deg, #ead08f, #d4b26a 45%, #b8873c);
    color: #0b0b0c;
    box-shadow: 0 0 0 6px rgb(212 178 106 / 0.18), 0 0 30px rgb(212 178 106 / 0.45);
  }
  .process-step.is-active .flip-inner { transform: rotateY(180deg); }
  .no-js .process-fill { transform: none; }
  .no-js .flip-inner { transform: rotateY(180deg); }
</style>
