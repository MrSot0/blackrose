---
import { Image } from 'astro:assets';
import { services } from '../data/site';
---
<section id="services" class="relative overflow-hidden bg-bone-50 py-24 text-carbon-900 md:py-36">
  <div class="pointer-events-none absolute -top-40 -right-40 size-[34rem] rounded-full bg-gold-300/40 blur-[110px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute bottom-0 -left-40 size-[28rem] rounded-full bg-rose-400/15 blur-[110px]" aria-hidden="true"></div>

  <div class="container-x relative">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="reveal text-xs font-medium tracking-[0.3em] text-rose-500 uppercase">Services</p>
        <h2 class="reveal mt-5 font-display text-[clamp(2.1rem,5vw,3.9rem)] leading-[1.05] font-extralight tracking-tight text-carbon-950" style="--d:80ms">
          From window decals<br />to <span class="italic text-gold-500">conference sets.</span>
        </h2>
      </div>
      <p class="reveal max-w-md text-lg leading-relaxed text-steel-600 lg:col-span-4" style="--d:160ms">
        We handle concept, artwork, production and installation, so your brand looks the same everywhere it shows up.
      </p>
    </div>

    <ul class="mt-14 grid gap-5 sm:grid-cols-2 md:mt-20 lg:grid-cols-3 lg:gap-6">
      {services.map((s, i) => (
        <li class="reveal group" style={`--d:${(i % 3) * 100}ms`}>
          <article class="relative h-full overflow-hidden rounded-2xl bg-white shadow-[0_1px_0_rgb(0_0_0/0.04),0_20px_40px_-24px_rgb(11_11_12/0.35)] ring-1 ring-carbon-950/5 transition-all duration-500 ease-out-soft hover:-translate-y-1.5 hover:shadow-[0_30px_60px_-28px_rgb(11_11_12/0.5)]">
            <div class="relative aspect-[4/3] overflow-hidden">
              <Image src={s.image} alt={s.alt} widths={[400, 700]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw" class="h-full w-full object-cover transition-transform duration-[1.2s] ease-out-soft group-hover:scale-110" />
              <div class="absolute inset-0 bg-gradient-to-t from-carbon-950/70 via-transparent to-transparent"></div>
              <span class="absolute top-4 left-1/2 grid size-10 -translate-x-1/2 place-items-center rounded-full bg-gold-gradient font-display text-sm text-carbon-950">0{i + 1}</span>
              <h3 class="absolute inset-x-4 bottom-4 text-center font-display text-2xl font-light text-bone-50">{s.title}</h3>
            </div>
            <p class="p-5 text-center leading-relaxed text-steel-600 md:p-6">{s.copy}</p>
            <span class="absolute bottom-0 left-1/2 h-1 w-0 -translate-x-1/2 bg-gradient-to-r from-gold-400 to-rose-500 transition-all duration-700 ease-out-soft group-hover:w-full"></span>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>
